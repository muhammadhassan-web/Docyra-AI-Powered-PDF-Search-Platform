# MongoDB Atlas connection string (no credentials in code, ever)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/docyra?appName=Cluster0

# Secret used to sign JWTs — generate a long random value, e.g. `openssl rand -base64 48`
JWT_SECRET=

# Origin(s) allowed to call the API (frontend URL)
CORS_ORIGIN=http://localhost:5173

# Cloudinary (used for server-signed uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini — powers both chat and embeddings (retrieval). Free tier, no
# credit card required — get a key at aistudio.google.com/apikey.
# Without this set, chat is unavailable and uploads skip embedding (chat then
# falls back to stuffing recent documents into the prompt — see
# server/utils/retrieval.js — once GEMINI_API_KEY is set for chat itself).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

PORT=5000
NODE_ENV=development

# Optional: raise the /api/auth rate limit (requests per 15 min per IP).
# Defaults to 20. Integration tests set this much higher.
AUTH_RATE_LIMIT=20

# Optional: raise the employee-login rate limit (requests per 15 min per
# company code). Defaults to 15. Integration tests set this much higher.
EMPLOYEE_LOGIN_RATE_LIMIT=15

# Frontend: base URL of the API (must match a CORS_ORIGIN-allowed origin in reverse — see above)
VITE_API_BASE_URL=http://localhost:5000
